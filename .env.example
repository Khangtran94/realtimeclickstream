# Copy this file to .env and fill in the values
# Never commit the real .env file

# Required – name of the Kinesis stream created by Terraform
KINESIS_STREAM_NAME=ecommerce-stream

# AWS region (must match Terraform)
AWS_REGION=ap-southeast-1

# DynamoDB table name (must match Terraform)
DYNAMODB_TABLE=clickstream-sessions

# Optional – only needed if you run the batch job against S3 later
# S3_RAW_BUCKET=realtimeclickstream-raw-events
# S3_PROCESSED_BUCKET=realtimeclickstream-processed-events
